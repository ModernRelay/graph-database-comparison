CREATE CLASS Person EXTENDS V;
CREATE PROPERTY Person.slug STRING;
CREATE PROPERTY Person.name STRING;
CREATE PROPERTY Person.age INTEGER;
CREATE INDEX Person.slug UNIQUE;
CREATE CLASS Company EXTENDS V;
CREATE PROPERTY Company.slug STRING;
CREATE PROPERTY Company.name STRING;
CREATE INDEX Company.slug UNIQUE;
CREATE CLASS Project EXTENDS V;
CREATE PROPERTY Project.slug STRING;
CREATE PROPERTY Project.name STRING;
CREATE INDEX Project.slug UNIQUE;
CREATE CLASS WorksAt EXTENDS E;
CREATE PROPERTY WorksAt.out LINK Person;
CREATE PROPERTY WorksAt.in LINK Company;
CREATE CLASS ContributesTo EXTENDS E;
CREATE PROPERTY ContributesTo.out LINK Person;
CREATE PROPERTY ContributesTo.in LINK Project;
